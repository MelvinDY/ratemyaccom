# Backend Configuration Example
# Copy this to .env.local and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL Connection String
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/ratemyaccom"

# SSL Configuration (set to "true" in production)
DATABASE_SSL="false"

# Connection Pool Settings
DATABASE_POOL_MAX="10"
DATABASE_POOL_MIN="2"

# ============================================
# APPLICATION SETTINGS
# ============================================

# Environment
NODE_ENV="development"

# API Base URL
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ============================================
# SCRAPING CONFIGURATION (Optional)
# ============================================

# Logging Level (debug, info, warn, error)
LOG_LEVEL="info"

# Rate Limiting for Scrapers (milliseconds)
SCRAPER_RATE_LIMIT="3000"

# Maximum Retries
SCRAPER_MAX_RETRIES="3"

# Scraper Timeout (milliseconds)
SCRAPER_TIMEOUT="30000"

# ============================================
# CACHING (Optional - Redis)
# ============================================

# Redis URL (if using Redis for caching)
# REDIS_URL="redis://localhost:6379"

# Cache TTL (seconds)
# CACHE_TTL="3600"

# ============================================
# AUTHENTICATION (Future - NextAuth.js)
# ============================================

# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="your-secret-key-here"

# OAuth Providers (Future)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ============================================
# MONITORING (Optional)
# ============================================

# Sentry DSN (for error tracking)
# SENTRY_DSN=""

# Vercel Analytics
# VERCEL_ANALYTICS_ID=""

# ============================================
# EXAMPLE VALUES FOR DIFFERENT ENVIRONMENTS
# ============================================

# Development (Local PostgreSQL)
# DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/ratemyaccom"
# DATABASE_SSL="false"

# Development (Docker PostgreSQL)
# DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/ratemyaccom"
# DATABASE_SSL="false"

# Production (Vercel Postgres)
# DATABASE_URL="postgres://default:xxx@xxx-pooler.region.aws.neon.tech:5432/verceldb?sslmode=require"
# DATABASE_SSL="true"

# Production (Supabase)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# DATABASE_SSL="true"

# Production (Railway)
# DATABASE_URL="postgresql://postgres:xxx@xxx.railway.app:5432/railway"
# DATABASE_SSL="true"

# ============================================
# NOTES
# ============================================

# 1. Never commit .env.local to git
# 2. Keep production credentials secure
# 3. Use different databases for dev/staging/prod
# 4. Rotate secrets regularly in production
# 5. Enable SSL in production (DATABASE_SSL="true")

# For Vercel deployment:
# - Set these as environment variables in Vercel dashboard
# - Or use: vercel env pull .env.local

# For local development:
# 1. Copy this file to .env.local
# 2. Update DATABASE_URL with your credentials
# 3. Run: npm run db:migrate
# 4. Run: npm run db:seed
